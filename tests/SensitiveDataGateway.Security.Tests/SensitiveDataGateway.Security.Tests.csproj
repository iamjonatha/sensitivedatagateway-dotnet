<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This suite deliberately gets no InternalsVisibleTo grant from anything. It stands where
    an application stands, so if a guarantee here can only be asserted with internal access,
    the guarantee cannot be checked by the people who depend on it, and that is a finding
    about the API rather than a reason to widen it.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/SensitiveDataGateway/SensitiveDataGateway.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Testing/SensitiveDataGateway.Testing.csproj" />
  </ItemGroup>

  <!--
    The adapters are referenced so that their assemblies, and the parsers they carry, land in
    this suite's output directory where NetworkCapabilityTests can read them. No test here
    calls into them: hard rule 7 is a property of what they are built from, not of what they
    do when invoked.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/SensitiveDataGateway.Documents.Mime/SensitiveDataGateway.Documents.Mime.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Documents.OpenXml/SensitiveDataGateway.Documents.OpenXml.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Documents.Pdf/SensitiveDataGateway.Documents.Pdf.csproj" />
  </ItemGroup>

</Project>
