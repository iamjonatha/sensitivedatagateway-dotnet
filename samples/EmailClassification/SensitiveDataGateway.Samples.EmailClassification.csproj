<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reference scenario end to end: an email with the attachments an office actually sends.
    It is part of the solution, so a change that breaks the path from a .eml file to a provider
    call breaks the build.

    The package references below are for *writing* the synthetic message and its attachments.
    The adapters only read. A sample that shipped a binary fixture would hide the one thing
    worth reading here, which is what is inside each attachment.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/SensitiveDataGateway.Extensions/SensitiveDataGateway.Extensions.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Documents.Mime/SensitiveDataGateway.Documents.Mime.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Documents.Pdf/SensitiveDataGateway.Documents.Pdf.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Documents.OpenXml/SensitiveDataGateway.Documents.OpenXml.csproj" />
    <ProjectReference Include="../../src/SensitiveDataGateway.Testing/SensitiveDataGateway.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="MimeKitLite" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

</Project>
