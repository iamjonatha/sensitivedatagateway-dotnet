<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Dependency policy: only Microsoft-maintained framework/extension packages are allowed in
    shipping projects, and every entry is classified by the capability it brings into the
    trust boundary. Test and benchmark tooling is the single documented exception, because it
    never reaches a package. See docs/security/dependency-classification.md and
    CONTRIBUTING.md -> "Dependency policy".
  -->
  <!--
    Shipping projects multi-target net8.0 and net10.0. Each target framework takes the
    matching major, so a .NET 8 consumer is never dragged onto the .NET 10 extension stack by
    a dependency of ours. NuGet evaluates this file once per target framework, which is what
    makes the conditions work.
  -->
  <ItemGroup Label="Framework extensions, .NET 8" Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup Label="Framework extensions, .NET 10" Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Build-time analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!--
    A Providers.* package may reference the library it exists to adapt, and only that one.
    DecisionKit.Core carries the abstractions; the transport lives in DecisionKit.Jev, which
    the application composes itself and which this repository never references. See
    docs/adr/0011-decisionkit-first-integration.md.
  -->
  <ItemGroup Label="Provider integrations">
    <PackageVersion Include="DecisionKit.Core" Version="0.1.0" />
  </ItemGroup>

  <!--
    A Documents.* package may reference one parser for the format it adapts, and nothing
    else. Each is classified "Sensitive-data processing": it reads raw content, so it never
    appears in Core or in the pipeline package. The six criteria the parsers were taken
    against, and the capability each one must not have, are in
    docs/adr/0018-format-adapters-may-take-a-parser.md.

    MimeKitLite, not MimeKit. They are the same parser from the same project; the Lite build
    leaves out S/MIME and OpenPGP, which is where MimeKit reaches the network to fetch a
    revocation list or a public key. This reader never decrypts and never verifies, so the
    whole capability is dropped rather than left present and unused.

    DocumentFormat.OpenXml covers both Word and Excel. The assembly is monolithic — one file
    for wordprocessing, spreadsheet and presentation markup — so the two extractors ship in
    one package rather than two that would install the same bytes twice. It is also the one
    parser here that prohibits document type declarations outright, which is what keeps XXE
    off the table by construction rather than by configuration.
  -->
  <ItemGroup Label="Document format parsers">
    <PackageVersion Include="MimeKitLite" Version="4.18.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Label="Benchmark tooling">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Test tooling">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="DecisionKit.Testing" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup Label="Host composition, used by tests and samples, .NET 8" Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="Host composition, used by tests and samples, .NET 10" Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

</Project>
