<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Composes SensitiveDataGateway into a dependency injection container and reads a
      sanitization policy out of configuration. Registration is eager: a policy that cannot be
      built throws where it is registered, before the application starts, and the message names
      the registration rather than anything the registration would have processed.
    </Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SensitiveDataGateway/SensitiveDataGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
