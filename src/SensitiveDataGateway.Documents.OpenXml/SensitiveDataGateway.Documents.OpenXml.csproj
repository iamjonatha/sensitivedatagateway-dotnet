<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Turns a Word or Excel document into SensitiveDataGateway segments: paragraphs, table
      rows, headers, footers, comments, notes, sheet cells and formula text, plus the
      package properties. It reads what the file holds and nothing else — it opens no
      socket, resolves no entity, follows no link, and refuses a document whose content it
      cannot read in place.
    </Description>
  </PropertyGroup>

  <!--
    The format parsers are not claimed to be trimmable or Native AOT safe. The guarantee
    covers Core, the pipeline, Extensions and Providers.*; see
    docs/adr/0018-format-adapters-may-take-a-parser.md -> Consequences.
  -->
  <PropertyGroup>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SensitiveDataGateway.Core/SensitiveDataGateway.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

</Project>
